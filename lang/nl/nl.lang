# ZKeypass interface language file.
#
# To translate ZKeypass, copy this folder, rename the folder and the file to
# your language code -- fr\fr.lang, ar\ar.lang -- and put it beside this
# one in the lang folder. Then change only the text on the right of each
# equals sign. Leave the section names in square brackets and the key names
# on the left exactly as they are: they are what ZKeypass looks the text up
# by, and translating them makes the line do nothing.
#
# Anything in curly braces is filled in by ZKeypass, so {count} becomes a
# number and {name} becomes a name. Keep every one that appears on a line,
# spelled the same way. You may move them wherever your own grammar needs
# them. Three braces, as in {{{command}}}, are a brace you see around the
# value; keep them as they are.
#
# Where a line ends in _one and another ends in _many, they are the singular
# and the plural of the same message. If your language needs a different
# split, write whatever is correct in each: ZKeypass picks _one when the
# number is exactly one and _many otherwise.
#
# A text that starts or ends with spaces is written between double quotes,
# so the spaces are kept. Keep the quotes and the spaces in your
# translation. \n starts a new line.
#
# On menus and buttons the & before a letter marks the Alt key. ZKeypass keeps
# the English Alt letter whatever you write, adding it in brackets after
# your words, so the same key reaches the same thing in every language.
#
# A key you have not translated yet is heard in English rather than being
# silent, so a part-finished file is safe to use and safe to share.
#
# Save the file as UTF-8. Lines beginning with a hash are notes and are
# ignored.

[meta]
name = Nederlands
code = nl
direction = ltr
translator = ZKeypass

