# Windows and dialogs: titles, labels, buttons, notes.
[dialogs]
1password_import = Nhập từ 1Password
1password_opvault_import = Nhập từ 1Password OPVault
1pux_export = Xuất 1PUX
a_browser_extension_can_ask_zkeypass = Tiện ích mở rộng của trình duyệt có thể yêu cầu ZKeypass cung cấp thông tin đăng nhập, yêu cầu mật khẩu được tạo, yêu cầu mã xác minh và lưu thông tin đăng nhập mới. Mọi thông điệp sau bước bắt tay đều được mã hóa bằng ChaCha20-Poly1305. Việc ghép nối luôn cần bạn chấp thuận, và dịch vụ chỉ lắng nghe trên máy này.
a_browser_extension_uses_one_of = Tiện ích mở rộng của trình duyệt dùng một trong hai kênh truyền: ổ cắm loopback, hoặc native messaging khi chính trình duyệt khởi động ZKeypass. Tệp manifest cho native messaging được ghi trong thư mục chương trình.
a_command_in_the_sequence_is = Một lệnh trong chuỗi thiếu dấu ngoặc nhọn đóng.
a_key_file = một tệp khóa
a_long_passphrase_of_four_or = Một cụm mật khẩu dài từ bốn từ trở lên mạnh hơn một mật khẩu ngắn phức tạp.
a_master_password = một mật khẩu chính
a_passkey_created_here_is_saved = Passkey được tạo ở đây sẽ được lưu khi bạn chọn OK. Việc quản lý passkey trên một mục chưa từng được lưu chỉ thực hiện được sau lần lưu đầu tiên.
a_passkey_is_an_elliptic_curve = Passkey là một cặp khóa đường cong elliptic được lưu trong cơ sở dữ liệu. ZKeypass có thể tạo một passkey, hiển thị phần công khai mà trang web cần và ký xác nhận khi được yêu cầu. Được lưu với tên thuộc tính của KeePassXC, nên cơ sở dữ liệu KeePass giữ được chúng theo cả hai chiều.
