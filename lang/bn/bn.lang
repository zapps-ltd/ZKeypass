# Windows and dialogs: titles, labels, buttons, notes.
[dialogs]
1password_import = 1Password ইমপোর্ট
1password_opvault_import = 1Password OPVault ইমপোর্ট
1pux_export = 1PUX এক্সপোর্ট
a_browser_extension_can_ask_zkeypass = ব্রাউজার এক্সটেনশন ZKeypass-এর কাছে লগইন চাইতে পারে, তৈরি করা পাসওয়ার্ড চাইতে পারে, যাচাইকরণ কোড চাইতে পারে এবং নতুন লগইন সংরক্ষণ করতে পারে। হ্যান্ডশেকের পরের প্রতিটি বার্তা ChaCha20-Poly1305 দিয়ে এনক্রিপ্ট করা হয়। পেয়ারিংয়ে সবসময় আপনার অনুমোদন লাগে, এবং পরিষেবাটি শুধু এই মেশিনেই শোনে।
a_browser_extension_uses_one_of = ব্রাউজার এক্সটেনশন দুটি ট্রান্সপোর্টের একটি ব্যবহার করে: লুপব্যাক সকেট, অথবা নেটিভ মেসেজিং যেখানে ব্রাউজার নিজেই ZKeypass চালু করে। নেটিভ মেসেজিংয়ের ম্যানিফেস্ট প্রোগ্রাম ফোল্ডারের ভেতরে লেখা হয়।
a_command_in_the_sequence_is = অনুক্রমের একটি কমান্ডে বন্ধ করার ব্রেস নেই।
a_key_file = একটি কী ফাইল
a_long_passphrase_of_four_or = চার বা তার বেশি শব্দের লম্বা পাসফ্রেজ ছোট জটিল পাসওয়ার্ডের চেয়ে শক্তিশালী।
a_master_password = একটি মাস্টার পাসওয়ার্ড
a_passkey_created_here_is_saved = এখানে তৈরি করা পাসকি আপনি ঠিক আছে বেছে নিলে সংরক্ষিত হয়। যে এন্ট্রি কখনও সংরক্ষণ করা হয়নি তার পাসকি পরিচালনা শুধু প্রথম সংরক্ষণের পরেই কাজ করে।
a_passkey_is_an_elliptic_curve = পাসকি হলো ডেটাবেসের ভেতরে রাখা একটি এলিপ্টিক কার্ভ কী জোড়া। ZKeypass একটি তৈরি করতে পারে, সাইটের প্রয়োজনীয় পাবলিক অংশ দেখাতে পারে এবং অনুরোধে অ্যাসার্শনে স্বাক্ষর করতে পারে। KeePassXC-এর অ্যাট্রিবিউট নামে সংরক্ষিত হয়, ফলে KeePass ডেটাবেস দুই দিকেই এগুলো রাখে।
a_screen_reader = একটি স্ক্রিন রিডার
a_security_key = একটি সিকিউরিটি কী
a_security_key_can_be_part = সিকিউরিটি কী মাস্টার কীর অংশ হতে পারে, ফলে ফিজিক্যাল কী ছাড়া ডেটাবেস খোলা যায় না। চ্যালেঞ্জ ও তার উত্তর কখনও ডেটাবেসে লেখা হয় না। ZKeypass চ্যালেঞ্জ সরাসরি USB-র মাধ্যমে কী-তে পাঠায় এবং উত্তর কখনও সংরক্ষণ করে না।
a_security_key_can_be_required = ডেটাবেস খোলার বা তৈরির সময় সিকিউরিটি কী বাধ্যতামূলক করা যায়। ZKeypass নিজেই USB-র মাধ্যমে চ্যালেঞ্জ পাঠায়; উত্তর কখনও ডিস্কে লেখা হয় না।
