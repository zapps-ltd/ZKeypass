# Windows and dialogs: titles, labels, buttons, notes.
[dialogs]
1password_import = درون‌ریزی از 1Password
1password_opvault_import = درون‌ریزی از 1Password OPVault
1pux_export = صدور 1PUX
a_browser_extension_can_ask_zkeypass = یک افزونهٔ مرورگر می‌تواند از ZKeypass اطلاعات ورود، یک گذرواژهٔ ساخته‌شده یا یک کد تأیید بخواهد و یک ورود جدید ذخیره کند. هر پیام پس از دست‌دهی با ChaCha20-Poly1305 رمزگذاری می‌شود. جفت‌سازی همیشه به تأیید شما نیاز دارد و این سرویس فقط روی همین رایانه گوش می‌دهد.
a_browser_extension_uses_one_of = یک افزونهٔ مرورگر از یکی از دو روش انتقال استفاده می‌کند: یک سوکت loopback، یا پیام‌رسانی بومی که در آن خود مرورگر ZKeypass را اجرا می‌کند. مانیفست پیام‌رسانی بومی درون پوشهٔ برنامه نوشته می‌شود.
a_command_in_the_sequence_is = یکی از دستورهای دنباله آکولاد بسته ندارد.
a_key_file = یک فایل کلید
a_long_passphrase_of_four_or = یک عبارت عبور بلند با چهار کلمه یا بیشتر از یک گذرواژهٔ کوتاه و پیچیده قوی‌تر است.
a_master_password = یک گذرواژهٔ اصلی
a_passkey_created_here_is_saved = کلید عبوری که اینجا ساخته می‌شود با انتخاب «تأیید» ذخیره می‌شود. مدیریت کلیدهای عبور روی ورودی‌ای که هرگز ذخیره نشده، فقط پس از نخستین ذخیره کار می‌کند.
a_passkey_is_an_elliptic_curve = کلید عبور یک جفت کلید منحنی بیضوی است که درون پایگاه داده نگه داشته می‌شود. ZKeypass می‌تواند یکی بسازد، بخش عمومی موردنیاز یک سایت را نشان دهد و در صورت درخواست یک اظهار را امضا کند. با نام صفت‌های KeePassXC ذخیره می‌شود، بنابراین پایگاه دادهٔ KeePass آن‌ها را در هر دو جهت نگه می‌دارد.
a_screen_reader = یک صفحه‌خوان
